GEMINI_API_KEY=your_gemini_api_key_here
# Optional. Defaults to local SQLite when omitted.
# DATABASE_URL=sqlite:///./aura_db.db

# Calendar preparation only: leave disabled until real authorization/client is implemented.
# Enabling now blocks scheduling when Feishu availability cannot be confirmed.
FEISHU_CALENDAR_ENABLED=false
# Reserved server-side credentials. These do not activate the integration.
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_OAUTH_REDIRECT_URI=https://your-host/api/integrations/feishu/callback
